<Window x:Class="Izdatelstvo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izdatelstvo"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="300">
    <Window.Resources>
        <Style TargetType="Grid">
            <Setter Property="Background" Value="Purple"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Century Gothic"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    <Grid Background="#FFC8BCFF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Label VerticalAlignment="Center" HorizontalAlignment="Center" Grid.RowSpan="2" Grid.ColumnSpan="2" FontSize="17" Content="АВТОРИЗАЦИЯ"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Логин"/>
        <Label Grid.Row="3" Grid.Column="0" Content="Пароль"/>
        <Label Grid.Row="4" Grid.Column="0" Content="Сервер"/>
        <Label Grid.Row="5" Grid.Column="0" Content="БД"/>

        <TextBox Grid.Column="1" Grid.Row="2" Margin="0,15,25,15" x:Name="log"/>
        <TextBox Grid.Column="1" Grid.Row="3" Margin="0,15,25,15" x:Name="pas"/>
        <TextBox Grid.Column="1" Grid.Row="4" Margin="0,15,25,15" x:Name="serv"/>
        <TextBox Grid.Column="1" Grid.Row="5" Margin="0,15,25,15" x:Name="bd"/>

        <Button Grid.Row="6" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="110,35,110,35" x:Name="vxod" Click="vxod_Click" Content="Войти" />
    </Grid>
</Window>
