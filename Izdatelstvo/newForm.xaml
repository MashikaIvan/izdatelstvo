<Window x:Class="Izdatelstvo.newForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izdatelstvo"
        mc:Ignorable="d"
        Title="newForm" Height="450" Width="800">
    <Grid>
        <Button x:Name="zapros" Content="Выполнить запрос 1" HorizontalAlignment="Left" Margin="87,69,0,0" VerticalAlignment="Top" Height="23" Width="118" Click="zapros_Click"/>
        <Label Content="Количество строк" HorizontalAlignment="Left" Margin="10,38,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="result" HorizontalAlignment="Left" Margin="157,42,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <DataGrid x:Name="dg" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,108,263,38"/>
        <Button x:Name="zapros2" Content="Выполнить запрос 2" HorizontalAlignment="Left" Margin="111,251,0,0" VerticalAlignment="Top" Height="23" Width="117" Click="zapros2_Click"/>
        <Label Content="Название категории" HorizontalAlignment="Left" Margin="367,33,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="newkat" HorizontalAlignment="Left" Margin="389,64,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="addnew" Content="Добавить" HorizontalAlignment="Left" Margin="367,91,0,0" VerticalAlignment="Top" Height="24" Width="142" Click="addnew_Click"/>
    </Grid>
</Window>
